# Скопіюйте у .env і підставте свої ключі
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456789:AA...   # отримати у @BotFather в Telegram

# Необов'язково
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
MAX_TOKENS=1500
MAX_TURNS=8
MAX_COST_USD=0.10
BOT_NAME=Кіндрат
PUBLIC_BASE_URL=   # HTTPS-адреса webapp/server.py (напр. від ngrok) — потрібна для /dashboard
