# Заміни yourdomain.com на реальний домен, що вказує A-записом на цей сервер.
# Caddy сам випускає й оновлює TLS-сертифікат Let's Encrypt — нічого більше
# налаштовувати не треба. webapp/server.py слухає лише 127.0.0.1:8000,
# назовні дивиться тільки Caddy.

yourdomain.com {
    reverse_proxy 127.0.0.1:8000
}
