[Unit]
Description=Personal Trainer Dashboard (Mini App backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trainerbot
Group=trainerbot
WorkingDirectory=/opt/AI_AGENTS/module1personalAgent
ExecStart=/opt/AI_AGENTS/module1personalAgent/.venv/bin/uvicorn webapp.server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
