# Скопіюйте у .env і підставте свій ключ
ANTHROPIC_API_KEY=sk-ant-...

# Потрібен лише для bot.py. Отримати: @BotFather у Telegram → /newbot
TELEGRAM_BOT_TOKEN=123456789:AAабвгдеж...

# Потрібен для щоденних сповіщень про нову редакцію закону (watch.py).
# Власний numeric chat_id — напишіть боту /start, гляньте лог bot.py.
ADMIN_CHAT_ID=123456789

# Необовʼязково
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_TOKENS=1800
MAX_TURNS=8
